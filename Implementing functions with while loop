#Implementing functions with while loop
def sq():
  a=int(input("Enter the Side: "))
  print("Area of square: ",a*a)
def cir(r):
  print("Area of circle: ",r*r*3.14)
def rect(a,b):
  return a*b


while(True):
  print("1.Square")
  print("2.Circle")
  print("3.Rectangle")
  print("4.exit")
  choice=int(input("Enter your choice: "))
  if choice==1:
    sq()
  elif choice==2:
    cir(10)
  elif choice==3:
    res=rect(10,20)
    print("Area of rectangle: ",res)
  else:
    print("Exit......")
    break


