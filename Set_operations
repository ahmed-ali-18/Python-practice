#set operations
a={2,3,4,5,6,7}
b={1,2,37,9,10,7}
print(a.union(b))
print(a | b)
print(a.intersection(b))
print(a&b)
print(a.difference(b)) #a-b
print(a-b)
print(b.difference(a))
print(b-a)
print(a.symmetric_difference(b))  #print other than common
print(a^b)
